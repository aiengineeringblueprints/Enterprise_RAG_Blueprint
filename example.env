OPENAI_API_KEY=# Your API Key here
OPENAI_BASE_URL=# Your LLM BaseURL here
MODEL_NAME= # Your Model Name here
LLM_SOURCE_ANSWER=openai
LLM_SOURCE_CHECK=openai
# Sampling temperature (default 0). Leave empty for models that reject the parameter.
LLM_TEMPERATURE=0
VECTORSTORE=local# - DEV_MODE=true: uvicorn with --reload (no OpenTelemetry)
# - DEV_MODE=false or unset: opentelemetry-instrument uvicorn (production mode)
VECTORDB_DIR=/data/vectordb
EMBEDDING_SOURCE=ollama
# Ollama embedding model for loader and chain (default nomic-embed-text).
# Changing it requires re-uploading all documents.
EMBEDDING_MODEL=nomic-embed-text
INDEX_NAME=dev-index
RETRIEVER_SIMILARITY_THRESHOLD=0.5
# Documents retrieved per question (default 5)
RETRIEVER_TOP_K=5
OLLAMA_BASE_URL="http://ollama:11434"
# Optional Bearer token for an Ollama behind an authenticating proxy (embeddings)
OLLAMA_API_KEY=
RETRIEVER_DISABLE_FILTER=false

CHAIN_URL = "http://chain:8000/"

# Optional MCP support. Use the same secret in frontend and chain; generate locally.
MCP_ENABLED=false
MCP_CONFIG_FILE=/app/mcp_servers.example.json
MCP_IDENTITY_SECRET=
LOADER_URL = "http://loader:8002/"

# SQLite DB paths (inside mounted uploads volume)
USERS_DB_PATH=/app/uploads/db/users.db
CHATS_DB_PATH=/app/uploads/db/chats.db

# MinIO Configuration for Document Versioning (Required)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=rag-documents
MINIO_SECURE=false

# dev mode (set to true to enable hot-reload and disable OpenTelemetry usage)
DEV_MODE=false

# Guardrails Configuration
# Set to true to disable input validation guardrails (fail-open)
DISABLE_GUARDRAILS=false

# Query Refinement
# Set to true to disable query refinement step 
DISABLE_QUERY_REFINEMENT=false
