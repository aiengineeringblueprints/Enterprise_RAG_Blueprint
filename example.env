OPENAI_API_KEY=# Your API Key here
OPENAI_BASE_URL=# Your LLM BaseURL here
MODEL_NAME= # Your Model Name here
LLM_SOURCE_ANSWER=openai
LLM_SOURCE_CHECK=openai
VECTORSTORE=local# - DEV_MODE=true: uvicorn with --reload (no OpenTelemetry)
# - DEV_MODE=false or unset: opentelemetry-instrument uvicorn (production mode)
VECTORDB_DIR=/data/vectordb
EMBEDDING_SOURCE=ollama
INDEX_NAME=dev-index
RETRIEVER_SIMILARITY_THRESHOLD=0.2
OLLAMA_BASE_URL="http://ollama:11434"
RETRIEVER_DISABLE_FILTER=false

CHAIN_URL = "http://chain:8000/"
LOADER_URL = "http://loader:8002/"

# SQLite DB paths (inside mounted uploads volume)
USERS_DB_PATH=/app/uploads/db/users.db
CHATS_DB_PATH=/app/uploads/db/chats.db

# MinIO Configuration for Document Versioning (Required)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=rag-documents
MINIO_SECURE=false

# dev mode (set to true to enable hot-reload and disable OpenTelemetry usage)
DEV_MODE=false